# Server only. Copy to .env.local for local chat development. Never commit keys.
# Use the same Supabase project as the browser development environment.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Enable only after applying the chat migration and setting an OpenRouter key cap.
CHAT_ENABLED=false
# USD cents per UTC day; each accepted run reserves 10 cents conservatively.
CHAT_DAILY_BUDGET_CENTS=200
