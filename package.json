{
  "name": "angular-zurich",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node ./scripts/sync-production-env.mjs && ng build --configuration production",
    "build:development": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:angular-zurich": "node dist/angular-zurich/server/server.mjs",
    "lint": "ng lint && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.10.1",
  "overrides": {
    "@babel/core": "7.29.7",
    "esbuild": "0.28.1",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@angular/common": "^22.0.3",
    "@angular/compiler": "^22.0.3",
    "@angular/core": "^22.0.3",
    "@angular/forms": "^22.0.3",
    "@angular/platform-browser": "^22.0.3",
    "@angular/platform-server": "^22.0.3",
    "@angular/router": "^22.0.3",
    "@angular/ssr": "^22.0.4",
    "@supabase/supabase-js": "^2.98.0",
    "cally": "^0.9.2",
    "express": "^5.1.0",
    "preline": "^4.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.3",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.1": true
  }
}
